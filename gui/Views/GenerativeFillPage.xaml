<UserControl x:Class="SoftcurseMediaLabAI.Views.GenerativeFillPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.modernwpf.com/2019"
             PreviewKeyDown="UserControl_PreviewKeyDown"
             Background="Transparent">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Title -->
            <RowDefinition Height="*"/>      <!-- Form fields -->
            <RowDefinition Height="Auto"/>   <!-- Actions -->
        </Grid.RowDefinitions>

        <!-- ── TITLE ── -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="GENERATIVE IMAGE API" FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource CyberAccentBrush}" FontFamily="Segoe UI">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#00E5FF" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Text="Optional client for an external Stable Diffusion-compatible server. No generator or model is bundled with this app."
                       FontSize="11" Margin="0,5,0,0" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI"/>
            <TextBlock x:Name="SourceModeText" Text="Load an image in Image Editor first."
                       FontSize="10" Margin="0,5,0,0" Foreground="{StaticResource GoldAccentBrush}"
                       TextWrapping="Wrap" FontFamily="Segoe UI"/>
        </StackPanel>

        <!-- ── FORM FIELDS ── -->
        <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrightBrush}"
                BorderThickness="1" Background="#071018" Padding="16,14">
            <StackPanel>
                <TextBlock Text="PROMPT" FontSize="10" FontWeight="Bold"
                           Foreground="{StaticResource TextDimBrush}" FontFamily="Segoe UI"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="PromptTextBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True"
                         Margin="0,0,0,14" Style="{StaticResource HudTextBox}"
                         Text="A beautiful landscape, high quality, 8k resolution"/>

                <TextBlock Text="NEGATIVE PROMPT" FontSize="10" FontWeight="Bold"
                           Foreground="{StaticResource GoldAccentBrush}" FontFamily="Segoe UI"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="NegativePromptTextBox" Height="40" TextWrapping="Wrap" AcceptsReturn="True"
                         Margin="0,0,0,14" Style="{StaticResource HudTextBox}"
                         Text="watermark, text, signature, low quality"/>

                <TextBlock Text="API ENDPOINT (SD WEBUI)" FontSize="10" FontWeight="Bold"
                           Foreground="{StaticResource TextDimBrush}" FontFamily="Segoe UI"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="ApiEndpointTextBox" Margin="0,0,0,7" Style="{StaticResource HudTextBox}"
                         IsReadOnly="True" ToolTip="Change and test this endpoint in Settings."/>

                <Border Background="#1200E5FF" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        Padding="10" Margin="0,4,0,0">
                    <TextBlock Text="How it works: load an image in Image Editor, configure and test a trusted API in Settings, describe the desired change, then send the image to that server. Remote servers receive the source image and optional mask."
                               TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" FontSize="11" FontFamily="Segoe UI"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- ── ACTIONS ── -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CancelButton" Content="CANCEL" Click="Cancel_Click" Margin="0,0,10,0"
                    Style="{StaticResource BtnDanger}" Padding="14,6" IsEnabled="False"
                    ToolTip="Available while generation is running."/>
            <Button x:Name="GenerateButton" Content="SEND TO API" Click="Generate_Click"
                    Style="{StaticResource BtnPrimary}" Padding="18,6"
                    ToolTip="Requires an Image Editor source and a running compatible API (Ctrl+Enter)"/>
        </StackPanel>
    </Grid>
</UserControl>

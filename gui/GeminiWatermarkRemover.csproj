<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>SoftcurseMediaLabAI</AssemblyName>
    <ApplicationTitle>Softcurse Media Lab AI</ApplicationTitle>
    <!-- F-08: required for unsafe pointer tensor fill in WatermarkService -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>SoftcurseMediaLabAI</RootNamespace>
    <ApplicationIcon>..\assets\media.ico</ApplicationIcon>
    <!-- The application UI is English-only; do not ship unused dependency satellite resources. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- DirectML includes the managed API and CPU fallback; avoid shipping three
         competing ONNX Runtime native packages. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
    <PackageReference Include="ModernWpfUI" Version="0.9.6" />
    <PackageReference Include="OpenCvSharp4.Windows" Version="4.9.0.20240103" />
    <PackageReference Include="System.Numerics.Tensors" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\assets\logo.png" Link="assets\logo.png" />
  </ItemGroup>

</Project>
